{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/logo.svg", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/fonts/**", "/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "market-feed",
      "urls": ["/api/listings", "/api/listings?**", "/api/categories"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 80,
        "maxAge": "1h",
        "timeout": "3s"
      }
    },
    {
      "name": "media",
      "urls": ["/api/media/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 120,
        "maxAge": "30d"
      }
    }
  ],
  "navigationUrls": ["/**", "!/api/**"]
}
